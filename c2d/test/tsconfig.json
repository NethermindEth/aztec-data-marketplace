{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dest",
    "target": "es2020",
    "lib": ["esnext", "dom"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "esModuleInterop": true,
    "downlevelIteration": true,
    "inlineSourceMap": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "e2e",
    "artifacts",
    "../contracts/marketplace_c2d/target/**/*"
  ]
}